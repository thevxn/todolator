{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "draggable-window",
  "description": "Draggable window",
  "windows": ["*"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:app:allow-app-hide",
    "core:path:default",
    "fs:allow-audio-read",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }]
    }
  ]
}
