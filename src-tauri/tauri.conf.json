{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todolator",
  "version": "0.1.0",
  "identifier": "dev.vxn.todolator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Todolator",
        "width": 800,
        "height": 600,
        "decorations": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["*/**"]
      },
      "capabilities": [
        {
          "identifier": "draggable-window",
          "windows": ["*"],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit",
            "core:event:default",
            "core:app:allow-app-hide"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
